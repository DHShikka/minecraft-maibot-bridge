{
  "manifest_version": 2,
  "id": "mcai.minecraft-bridge",
  "version": "1.0.0",
  "name": "Minecraft AI 桥接",
  "description": "通过 WebSocket 把 Minecraft（Forge 1.20.1 客户端模组）接入 MaiBot：游戏内聊天与事件上报给麦麦思考，麦麦的决策再回传成游戏里的真实操作（移动、挖矿、放置、战斗、说话、执行指令）。",
  "author": {
    "name": "McAiBridge",
    "url": "https://github.com/mcai-bridge/minecraft-maibot"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/mcai-bridge/minecraft-maibot",
    "documentation": "https://github.com/mcai-bridge/minecraft-maibot/blob/main/README.md"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.8.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "plugin_type": "integration",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "gamepad-2",
      "fallback": "box",
      "background": "#3b6e3b"
    }
  },
  "capabilities": [
    "send.text",
    "chat.open_session",
    "chat.get_stream_by_group_id",
    "chat.get_stream_by_user_id",
    "maisaka.context.append",
    "maisaka.proactive.trigger"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "locales_path": "i18n",
    "supported_locales": ["zh-CN", "en-US"]
  }
}
